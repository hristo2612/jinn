{
  "name": "jinn",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/fix-prebuild-permissions.mjs",
    "build": "turbo build && node scripts/sync-web-dist.mjs",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo run test --concurrency=1",
    "coverage": "turbo run coverage",
    "test:e2e": "playwright test",
    "clean": "node -e \"const fs=require('fs');for(const d of ['.turbo','node_modules/.cache'])fs.rmSync(d,{recursive:true,force:true})\" && turbo clean",
    "jinn": "node packages/jinn/dist/bin/jinn.js",
    "setup": "pnpm build && node packages/jinn/dist/bin/jinn.js setup",
    "setup:force": "pnpm build && node packages/jinn/dist/bin/jinn.js setup --force",
    "start": "pnpm build && node packages/jinn/dist/bin/jinn.js start",
    "stop": "node packages/jinn/dist/bin/jinn.js stop",
    "nuke": "node packages/jinn/dist/bin/jinn.js nuke",
    "status": "node packages/jinn/dist/bin/jinn.js status",
    "upgrade-lab": "node scripts/upgrade-lab/run.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "classic-level",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "classic-level": "^2.0.0"
  }
}
